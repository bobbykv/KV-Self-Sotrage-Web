// SiteLink stays the system of record for tenants, units, ledgers, payments
// and access codes. This database only holds our cache, website-side queues,
// CMS content, sessions and audit logs. Never add card data columns here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One row per (location, kind). kind = "available" | "all" | "pricelist" | "paymenttypes" | "report".
model SiteLinkSnapshot {
  id             String    @id // `${locationKey}:${kind}`
  locationKey    String
  kind           String
  data           Json
  lastTimePolled String?
  refreshedAt    DateTime
  lastError      String?
  lastErrorAt    DateTime?

  @@index([locationKey])
}

model ApiCallCounter {
  id          String @id // `${yyyy-mm}:${locationKey}:${method}`
  month       String
  locationKey String
  method      String
  count       Int    @default(0)
  errors      Int    @default(0)

  @@index([month])
}

model Hold {
  id                String   @id
  locationKey       String
  unitId            Int
  unitName          String
  unitTypeName      String
  widthFt           Float
  lengthFt          Float
  tenantId          Int?
  /// True only when this checkout created the SiteLink tenant (gates portal-password setup).
  tenantCreated     Boolean  @default(false)
  portalPasswordSet Boolean  @default(false)
  waitingId         Int?
  quotedRate        Decimal  @db.Decimal(10, 2)
  firstName         String
  lastName          String
  email             String
  phone             String
  moveInDate        DateTime
  expiresAt         DateTime
  /// active | expired | released | confirmed_pay_separately | moved_in | payment_failed | error
  status            String   @default("active")
  costBreakdown     Json?
  ledgerId          Int?
  /// SiteLink receipt / transaction reference only. Never card data.
  paymentRef        String?
  failureCount      Int      @default(0)
  lastFailure       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([locationKey, unitId, status])
  @@index([status, expiresAt])
}

model Lead {
  id          String    @id @default(cuid())
  /// website_form | website_chat | voice | retell
  channel     String
  /// unavailable_unit | waitlist | contact_request | human_handoff
  reason      String
  name        String
  phone       String?
  email       String?
  locationKey String?
  unitType    String?
  unitSize    String?
  notes       String?
  ghlStatus   String    @default("pending") // pending | sent | failed | skipped
  ghlError    String?
  ghlSentAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("staff") // owner | staff
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  /// sha256 of the cookie token; the raw token only lives in the cookie.
  id          String     @id
  kind        String // admin | tenant
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// Tenant sessions: [{ locationKey, tenantId }]
  tenantData  Json?
  email       String?
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([expiresAt])
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  body           String
  coverImageUrl  String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Promotion {
  id         String    @id @default(cuid())
  headline   String
  body       String?
  code       String?
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean   @default(true)
  /// "all" or any of haley | hwy4 | stellarton
  locations  String[]
  /// homepage | units | checkout
  placements String[]
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  locationKey String
  unitName    String
  tenantId    Int?
  verified    Boolean  @default(false)
  name        String
  email       String?
  phone       String?
  issueType   String
  description String
  contactPref String
  photoIds    String[]
  status      String   @default("new") // new | in_progress | done
  staffNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model TransferRequest {
  id              String   @id @default(cuid())
  locationKey     String
  currentUnitName String
  tenantId        Int?
  name            String
  email           String?
  phone           String?
  direction       String // bigger | smaller | different_type
  desiredLocation String
  desiredSize     String?
  desiredFeatures String?
  timing          String
  reason          String?
  status          String   @default("new") // new | in_progress | done
  staffNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

model Upload {
  id        String   @id @default(cuid())
  mime      String
  size      Int
  bytes     Bytes
  isPublic  Boolean  @default(false)
  purpose   String // blog_cover | maintenance_photo
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
