# Copy to .env for local development. In production set these in the hosting
# provider's encrypted environment settings — never commit real values.

DATABASE_URL="postgresql://kv:kv@localhost:5432/kv"
APP_URL="http://localhost:3000"

# Public site environment: production | staging | test | development
# Search engines are only invited when this is production.
NEXT_PUBLIC_SITE_ENV="development"

# ---- Hosted / local simulator (see docs/TEST_ENVIRONMENT.md) ----
# APP_TEST_MODE=1 forces mock SiteLink + simulated card payments, blocks live
# SOAP / GHL / staff webhooks / pay-online / paid chat, and persists fake
# rentals in this DATABASE_URL. Use a SEPARATE test database on Vercel.
# APP_TEST_MODE=""

# ---- SiteLink (Transaction / Call Center API) ----
# Leave blank to run against the built-in mock (demo data). Mock mode refuses
# to start in production unless ALLOW_MOCK_IN_PRODUCTION=1 or APP_TEST_MODE=1.
SITELINK_MODE=""                     # live | mock (auto: live when all creds below are set)
SITELINK_CORP_CODE=""
SITELINK_LOCATION_CODES=""           # haley:CODE,hwy4:CODE,stellarton:CODE
SITELINK_API_USERNAME=""
SITELINK_API_PASSWORD=""
SITELINK_TEST_MODE=""                # 1 = SiteLink test mode for MoveIn calls
# SITELINK_ENDPOINT="https://api.smdservers.net/CCWs_3.5/CallCenterWs.asmx"
# SITELINK_REPORTING_ENDPOINT="https://api.smdservers.net/CCWs_3.5/ReportingWs.asmx"
# SITELINK_TIMEOUT_MS=20000
# SITELINK_TIMEZONE="America/Halifax"

# UNVERIFIED SiteLink enum values — confirm with SiteLink support (docs/SITELINK.md).
# SITELINK_INQUIRY_TYPE=0
# SITELINK_RESERVATION_STATUS_OPEN=0
# SITELINK_RESERVATION_STATUS_CANCELLED=     # unset = let dExpires lapse instead of cancelling
# SITELINK_RESERVATION_CANCEL_TYPE=0
# SITELINK_PAY_METHOD_CC=0
# SITELINK_CHANNEL_TYPE=0
# SITELINK_BILLING_FREQUENCY=0

# ---- Payments (owner decision required — see docs/ARCHITECTURE.md) ----
PAYMENT_MODE="pay_separately"        # pay_separately | passthrough (forced passthrough in APP_TEST_MODE)
PAY_ONLINE_URL=""                    # optional existing pay-online link shown in pay_separately mode
HST_RATE="0.14"

# ---- Media uploads (Vercel Blob). When unset, gallery photos fall back to Postgres. ----
BLOB_READ_WRITE_TOKEN=""
# BLOB_HOST_PATTERN="*.public.blob.vercel-storage.com"                      # fallback only, used when SiteLink returns no tax lines

# ---- GoHighLevel lead capture (either a workflow webhook OR API key + location) ----
# Prefer GHL_WEBHOOK_URL so Retell chat/call payloads (transcript + contact) land in a GHL workflow.
GHL_WEBHOOK_URL=""
GHL_API_KEY=""
GHL_LOCATION_ID=""

# ---- Website chat (optional; rules-based answers when unset) ----
CHAT_LLM_API_KEY=""
# CHAT_LLM_BASE_URL="https://api.openai.com/v1"
# CHAT_LLM_MODEL="gpt-4o-mini"

# ---- Retell website chat widget (optional; replaces built-in chat when both are set) ----
# Create a Chat Agent + Public Key in the Retell dashboard (whitelist your domain).
# Point the chat agent's prompt at GET /api/agent/brain?channel=website_chat and
# register custom functions from that response (Bearer AGENT_TOOL_SECRET).
# NEXT_PUBLIC_RETELL_PUBLIC_KEY="key_..."
# NEXT_PUBLIC_RETELL_CHAT_AGENT_ID="agent_..."
# Optional hybrid voice inside the same widget:
# NEXT_PUBLIC_RETELL_VOICE_PUBLIC_KEY="key_..."
# NEXT_PUBLIC_RETELL_VOICE_AGENT_ID="agent_..."
# NEXT_PUBLIC_RETELL_AGENT_VERSION=""
# NEXT_PUBLIC_RETELL_RECAPTCHA_KEY=""          # Google reCAPTCHA v3 site key if enabled on the public key

# ---- Staff notifications (maintenance, transfers, reservations, failed payments) ----
NOTIFY_WEBHOOK_URL=""                # e.g. a GHL / Slack / Zapier incoming webhook
OWNER_NOTIFY_EMAIL=""

# ---- Secrets for machine callers ----
CRON_SECRET=""                       # Vercel sends this as "Authorization: Bearer ..."
AGENT_TOOL_SECRET=""                 # ≥16 chars; Retell sends it as a Bearer token to /api/agent/*
RETELL_API_KEY=""                    # Retell API key with the webhook badge; verifies /api/retell/webhook

# ---- First owner account (used by `npm run db:seed`) ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""                    # ≥12 chars, 3 of: lower, upper, digit, symbol
# ADMIN_NAME="Owner"
# SEED_SAMPLE_CONTENT=1
